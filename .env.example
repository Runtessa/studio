DATABASE_URL=postgres://postgres:postgres@localhost:5432
DB_NAME=idpnext
DB_TYPE=postgres
CORE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/idpcore
CORE_DB_NAME=idpcore
CORE_DB_TYPE=postgres
# Server-only preview bridge. Use the same dedicated token in Runtime.
CORE_PREVIEW_INTERNAL_URL=http://127.0.0.1:3005
CORE_STUDIO_PREVIEW_TOKEN=replace_with_studio_preview_token
DEV_TENANT_HOST=localhost
ADMIN_TOKEN=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_ide_admin_password
REDIS_URL=redis://localhost:6379
AGENT_CONTAINER_MANAGER_TARGET=default
CONTAINER_ORCHESTRATOR_TIMEOUT_MS=20000
CONTAINER_ORCHESTRATOR_REQUEST_CHANNEL_PREFIX=idp:orchestrator:requests:
CONTAINER_ORCHESTRATOR_REPLY_CHANNEL_PREFIX=idp:orchestrator:reply:
MONITORING_SERVER_URL=https://localhost:3011
MONITORING_INGEST_TOKEN=change-me
MONITORING_ENFORCE_TLS=true
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=change-me
AI_MODEL=
AI_PROVIDER=
AI_ALLOW_CLIENT_CONFIG=false
# Empty uses the default model discovered from the signed-in Codex profile.
AGENT_CODEX_MODEL=
AGENT_CONTEXT_MAX_CHARS=0
AGENT_CODEX_GATEWAY_URL=http://127.0.0.1:4040
# Podman or Docker is configured in container-manager; IDE only calls that manager in container mode.
AGENT_CODEX_GATEWAY_MODE=local
AGENT_CODEX_GATEWAY_IMAGE=idp/codex-gateway:latest
AGENT_CODEX_GATEWAY_CONTAINER_PREFIX=idp-codex-gw
AGENT_CODEX_GATEWAY_PORT_RANGE=4600-4899
AGENT_CODEX_GATEWAY_HOST=127.0.0.1
AGENT_CONTAINER_MANAGER_URL=
AGENT_CONTAINER_MANAGER_TOKEN=
AGENT_CONTAINER_MANAGER_INSECURE_TLS=false
IDE_AUTH_SERVICE_URL=http://localhost:3015
IDE_AUTH_SERVICE_TOKEN=change-me-internal-auth-token
