{
  "name": "amnet-dashboard",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "cross-env NEXT_CSS_TRANSFORMER=postcss NEXT_DISABLE_LIGHTNINGCSS=1 NEXT_IGNORE_LIGHTNINGCSS_BIN=1 next dev --webpack -p 3002",
    "build": "npm --prefix ../packages/shared run build && cross-env NEXT_CSS_TRANSFORMER=postcss NEXT_DISABLE_LIGHTNINGCSS=1 NEXT_IGNORE_LIGHTNINGCSS_BIN=1 next build --webpack",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "test:security": "node --test tests/*.test.cjs",
    "db:status": "node ../packages/shared/dist/database/cli.js status --target ide",
    "db:plan": "node ../packages/shared/dist/database/cli.js plan --target ide",
    "db:diff": "node ../packages/shared/dist/database/cli.js diff --target ide",
    "db:migrate": "node ../packages/shared/dist/database/cli.js migrate --target ide",
    "db:adopt": "node ../packages/shared/dist/database/cli.js adopt --target ide",
    "dump": "node ./scripts/dump.js",
    "prebuild": "node ../../scripts/release/prepare-monaco.mjs",
    "predev": "node ../../scripts/release/prepare-monaco.mjs"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.0",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@idp/shared": "file:../packages/shared",
    "@mastra/core": "1.1.0",
    "@monaco-editor/react": "4.7.0",
    "autoprefixer": "10.4.24",
    "bcryptjs": "3.0.3",
    "chart.js": "4.5.1",
    "cssnano": "7.1.2",
    "esbuild": "0.28.2",
    "ioredis": "5.8.2",
    "monaco-editor": "0.57.0",
    "mysql2": "3.24.5",
    "next": "16.4.0",
    "pg": "8.16.3",
    "postcss": "8.5.29",
    "react": "19.2.4",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.2.4",
    "react-icons": "5.5.0",
    "react-markdown": "10.1.0",
    "reflect-metadata": "0.1.14",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "source-map-support": "0.5.21",
    "sqlite3": "6.0.1",
    "tailwindcss": "3.4.19",
    "tedious": "20.3.3",
    "typeorm": "0.3.31",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/bcryptjs": "3.0.0",
    "@types/ioredis": "4.28.10",
    "@types/node": "20.19.27",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/react-icons": "3.0.0",
    "@types/source-map-support": "0.5.10",
    "cross-env": "7.0.3",
    "lightningcss": "1.31.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runtessa/studio.git"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "private": true,
  "overrides": {
    "qs": "6.16.0",
    "uuid": "11.1.1",
    "serialize-javascript": "7.1.2",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6"
  }
}
